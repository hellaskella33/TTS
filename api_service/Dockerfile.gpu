# Production-ready GPU Dockerfile for TTS API Service
# Uses CUDA 12.1 runtime for NVIDIA GPUs (WSL2/Linux)

FROM nvidia/cuda:12.1.1-cudnn8-runtime-ubuntu22.04 as base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    COQUI_TOS_AGREED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    gcc \
    g++ \
    make \
    git \
    ffmpeg \
    pkg-config \
    espeak-ng \
    libsndfile1-dev \
    && rm -rf /var/lib/apt/lists/*

RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --upgrade pip setuptools wheel

WORKDIR /app

# ============================================
# Builder stage - Install Python dependencies
# ============================================
FROM base as builder

ENV PIP_NO_CACHE_DIR=0

COPY api_service/requirements.gpu.txt /app/requirements.gpu.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    python3 -m pip install --user -r /app/requirements.gpu.txt

# ============================================
# Final stage - Copy only necessary files
# ============================================
FROM base

COPY --from=builder /root/.local /root/.local
ENV PATH=/root/.local/bin:$PATH

COPY TTS/ /app/TTS/
COPY setup.py /app/
COPY README.md /app/
COPY requirements.txt /app/
COPY requirements.dev.txt /app/
COPY requirements.notebooks.txt /app/
COPY requirements.ja.txt /app/

RUN python3 -m pip install --no-cache-dir --no-deps .

COPY api_service/app.py /app/api_service/app.py

RUN mkdir -p /app/api_service/voices

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python3 -c "import requests; requests.get('http://localhost:8000/health', timeout=5)" || exit 1

CMD ["uvicorn", "api_service.app:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
